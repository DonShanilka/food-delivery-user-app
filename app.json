{
  "expo": {
    "name": "Food Delivery",
    "slug": "food-delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FF6B35"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow HotPlate to use your location to pin your delivery and track your order."
        }
      ]
    ],
    "extra": {
      "localHost": "192.168.1.123",
      "apiUrl": "http://192.168.1.123:3000/api"
    }
  }
}
